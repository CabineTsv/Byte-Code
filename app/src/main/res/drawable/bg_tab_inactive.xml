<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bc_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bc_tab_inactive" />
                </shape>
            </item>
            <item
                android:width="1dp"
                android:gravity="end">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bc_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
