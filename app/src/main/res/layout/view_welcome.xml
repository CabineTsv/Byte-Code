<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="40dp"
        android:paddingEnd="32dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/bc_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/welcome_tagline"
            android:textColor="@color/bc_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcome_open_folder"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/action_open_folder_short"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcome_open_file"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/action_open_file_short"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/welcome_recent_title"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.08"
            android:text="@string/welcome_recent"
            android:textColor="@color/bc_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/welcome_recent_list"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
